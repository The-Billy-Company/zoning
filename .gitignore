# Rust
target/
**/*.rs.bk

# Python (bindings/python — the PyPI half)
__pycache__/
*.py[cod]
*.egg-info/
.venv/
dist/
.pytest_cache/
.ruff_cache/

# Toolchain overrides for one machine. `.mise.toml` is tracked; this is the
# per-checkout escape hatch and nobody else's business.
mise.local.toml
mise.local.lock

# The link checker's response cache.
.lycheecache

# Machine-local scratch. Globbed, not literal: ad-hoc probe dirs get named
# `.local-something`, land one character outside a literal rule, and are then
# one `git add -A` away from committing a hardcoded home path.
.local*/
.DS_Store
