# What your editor should do before a formatter ever runs.
#
# This file is not a second opinion. Every value below is the value the tool
# that owns the language already produces: rustfmt for Rust, Ruff for Python,
# `zig fmt` for the fixture trees. An editor save cannot quietly change
# indentation kind, line endings, or final newlines out from under them.
#
# `max_line_length` is deliberately absent. Wrap policy belongs to the
# formatters, which know about string literals, URLs, and the column-aligned
# tables this repository is full of; a flat cap here would only fight them.
#
# Spec: https://spec.editorconfig.org/

root = true

[*]
charset                  = utf-8
end_of_line              = lf
insert_final_newline     = true
trim_trailing_whitespace = true
indent_style             = space
indent_size              = 4

# Rust: rustfmt `tab_spaces = 4`.
[*.rs]
indent_style = space
indent_size  = 4

# The zone language. It has no formatter, so this file IS its layout contract:
# four spaces inside a block, and column-aligned names in a `zones` stanza.
[*.zone]
indent_style = space
indent_size  = 4

# Zig, and the `.zon` manifests `zig fmt` also formats. Only fixture trees here.
[*.{zig,zon}]
indent_style = space
indent_size  = 4

# Python: ruff format, 4-space.
[*.{py,pyi}]
indent_style = space
indent_size  = 4

# Data and markup: 2-space, matching Taplo and the GitHub Actions conventions.
[*.{toml,yml,yaml,json}]
indent_style = space
indent_size  = 2

# Shell: matches `shfmt -i 2`.
[*.{sh,bash}]
indent_style = space
indent_size  = 2

# Markdown keeps trailing whitespace: two trailing spaces are a hard line break,
# and trimming them silently rewrites the rendered page.
[*.md]
trim_trailing_whitespace = false
