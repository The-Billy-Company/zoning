{
  "comments": {
    "lineComment": "//"
  },
  "brackets": [
    [
      "{",
      "}"
    ]
  ],
  "autoClosingPairs": [
    {
      "open": "{",
      "close": "}"
    },
    {
      "open": "\"",
      "close": "\"",
      "notIn": [
        "comment",
        "string"
      ]
    }
  ],
  "surroundingPairs": [
    [
      "{",
      "}"
    ],
    [
      "\"",
      "\""
    ]
  ],
  "wordPattern": "[^\\s{}\"']+",
  "indentationRules": {
    "increaseIndentPattern": "^[^}/\"]*\\{\\s*(?://.*)?$",
    "decreaseIndentPattern": "^\\s*\\}",
    "indentNextLinePattern": "\\bbecause\\s*$"
  }
}
